{
  "name": "arcanum-ui",
  "version": "0.1.0",
  "description": "Pixel-art RPG UI component library (CSS-first) — dark navy & cyan theme, zero dependencies",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "fonts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./src/arcanum-ui.css",
    "./tokens.css": "./src/tokens/tokens.css",
    "./fonts.css": "./src/tokens/fonts.css",
    "./fonts/*": "./fonts/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "demo:screenshot": "node scripts/screenshot-demo.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  },
  "keywords": [
    "rpg",
    "ui",
    "css",
    "pixel-art",
    "game-ui",
    "retro"
  ]
}
